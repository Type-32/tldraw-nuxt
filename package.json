{
  "name": "@type32/tldraw-nuxt",
  "version": "0.1.0",
  "description": "tldraw infinite canvas whiteboard as a Nuxt component",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Type-32/tldraw-nuxt.git"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "tldraw",
    "whiteboard",
    "canvas",
    "drawing",
    "infinite-canvas",
    "vue",
    "vue3"
  ],
  "author": "Type32",
  "bugs": {
    "url": "https://github.com/Type-32/tldraw-nuxt/issues"
  },
  "homepage": "https://github.com/Type-32/tldraw-nuxt#readme",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tldraw": "^4.1.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "^2.6.5",
    "@nuxt/eslint-config": "^1.9.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.1.3",
    "@nuxt/test-utils": "^3.19.2",
    "@types/node": "latest",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "changelogen": "^0.6.2",
    "nuxt": "^4.1.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
